{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "minProperties": 25, "maxProperties": 25,
  "patternProperties": {
    "^case-[0-9]{2}$": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["clauseId", "expectedAssertionId", "operation", "fixtureScope", "expectedOutcome"],
        "properties": {
          "clauseId": { "type": "string", "pattern": "^case-[0-9]{2}-clause-[0-9]{2}$" },
          "expectedAssertionId": { "type": "string", "pattern": "^case-[0-9]{2}-expected-[0-9]{2}$" },
          "operation": { "enum": ["auditDocument", "documentAccessRequirements", "cliDocument"] },
          "fixtureScope": { "type": "string", "pattern": "^case-[0-9]{2}$" },
          "expectedOutcome": { "type": "string", "minLength": 3 }
        }
      }
    }
  },
  "additionalProperties": false
}
